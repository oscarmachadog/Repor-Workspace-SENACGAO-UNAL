<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= etiqueta %> </title>
    <%- include('partials/head') %>

</head>

<body>

    <%- include('partials/navigation') %>
      ```html
      <main class="container vh-100 d-flex flex-column justify-content-center align-items-center">

    <div class="container mt-5">
```

            <h1>Bienvenidos Vista de Creacion de Usuario</h1>
            <h2>Gestion de Usuario</h2>
            
            <!-- el mensaje para la configuracion del backend-->

        <!-- FORMULARIO UNICO PARA EL DESENGLOSE DE LOS PASOS-->
         <form action="/autentication/registro" method="POST" id="formRegistro">


            <!-- ========= PASO 1 =========-->
         <div id="paso-1" class="paso-seccion">
                <h4>1. datos personales  (Identificacion)</h4>
                 <div class="mb-3">

                     <label> Tipo de Documento</label>
                     <select name="tipoDocumento" class="form-control" id="tipoDocumento" required>

                        <option value="CEDULA">CEDULA DE CIUDADANIA</option>
                            <option value="TI">TARJETA DE IDENTIDAD</option>
                                <option value="CE">CEDULA DE EXTRANJERIA</option>
                     </select>
                 </div> 
                 <label>Nombre del Documento</label>
                 <input type="text" name="numeroDocumento" class="form-control" id="numeroDocumento" placeholder="Digite su Cedula" required>           
            
            <button type="button" class="btn btn-primary" onclick="siguientePaso(2)">Validar / Continuar </button>
        </div>

        <!-- ========= PASO 2 ========== -->

        <div id="paso-2" class="paso-seccion">
             <h4>2. datos personales y Nombres</h4>
             <p class="text-muted">Ingrese sus Nombres y Apellidos tal como aparecen en su documento de indentificacion</p>
             
             <div class="row">
                
                <div class="col-md-6 mb-3">
                    <input type="text" name="primerNombre" class="form-control" id="primerNombre " 
                     placeholder="Digite su Primer Nombre" required>           
                </div>
                <div class="col-md-6 mb-3">
                    <input type="text" name="segundoNombre" class="form-control" id="segundoNombre " 
                     placeholder="Digite su Segundo Nombre" required>           
                </div>
             </div>
             <br>
             <div class="row">
                <div class="col-md-6 mb-3">
                    <label> Digite su Nombre completo</label>  
                    <input type="text" name="primerApellido" class="form-control" id="primerApellido " 
                     placeholder="Digite su Primer Apellido" required>           
                </div>
                <div class="col-md-6 mb-3">
                    <input type="text" name="segundoApellido" class="form-control" id="segundoApellido" 
                     placeholder="Digite su Segundo Apellido" required>  
                            
                </div>
             </div>
                        

             <br>
             <div class="mb-3">
                <label> Fecha de Nacimiento</label>
               <input type="date" name="fechaNacimiento" class="form-control" id="fechaNacimiento" required>
             </div>

             <button type="button" class="btn btn-secondary" onclick="siguientePaso(1)"> Atras </button>
             <button type="button" class="btn btn-primary" onclick="siguientePaso(3)"> Continuar </button>

             </div>


             <!-- ======== PASO 3 ======== -->
              <div id="paso-3" class="paso-seccion oculto">
                <h4>3. Correo Electronico</h4>
                <div class="mb-3">
                    <label> Correo Electronico</label>
                    <input type="email" name="correo" class="form-control" id="correo" placeholder="correo@gmail.com" required>
                </div>
                <br>
                <div class="mb-3">
                    <label> Confirmar Correo Electronico</label>
                    <input type="email" name="confirmarCorreo" class="form-control" id="confirmarCorreo" 
                    placeholder="Porfavor Confirmar correo Electronico" required>
                </div>
                <button type="button" class="btn btn-secondary" onclick="pasoAnterior(2)"> Atras </button>
                <button type="button" class="btn btn-success"> Finalizar Registro </button>

                
              </div>


            
         </form>
        </div>

        


      </main>



    <%- include('partials/footer') %>

    <!-- script de control para cambiar la vista local -->


    <script>


    
  function siguientePaso(pasoDestino){
    if (pasoDestino === 2){
        const doc = document.getElementById('numeroDocumento').value;

        if (doc){
            alert('Por favor ingrese el numero de documento');
            return;
        }
    }

    // ocultar todos los pasos
}
</script>

</body>
</html>