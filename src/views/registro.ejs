<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= etiqueta %></title>
  <%- include('partials/head') %>
</head>

<body>
  <%- include('partials/navigation') %>

  <main class="container py-5">
    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-6">
        <h1 class="mb-3">Crear usuario</h1>

        <form id="formRegistro" action="/autentication/registro" method="POST">
          <!-- Paso 1 -->
          <section id="paso-1" class="paso-seccion">
            <h2 class="h4 mb-3">1. Documento de identificación</h2>

            <div class="mb-3">
              <label for="tipoDocumento" class="form-label">Tipo de documento</label>
              <select id="tipoDocumento" name="tipoDocumento" class="form-control" required>
                <option value="">Seleccione una opción</option>
                <option value="CEDULA">Cédula de ciudadanía</option>
                <option value="TI">Tarjeta de identidad</option>
                <option value="CE">Cédula de extranjería</option>
              </select>
            </div>

            <div class="mb-3">
              <label for="numeroDocumento" class="form-label">Número de documento</label>
              <input
                type="text"
                id="numeroDocumento"
                name="numeroDocumento"
                class="form-control"
                required
              >
            </div>

            <button type="button" class="btn btn-primary" onclick="siguientePaso(2)">
              Continuar
            </button>
          </section>

          <!-- Paso 2 -->
          <section id="paso-2" class="paso-seccion" hidden>
            <h2 class="h4 mb-3">2. Datos personales</h2>
            <p>Escriba sus nombres y apellidos tal como aparecen en su documento.</p>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="primerNombre" class="form-label">Primer nombre</label>
                <input
                  type="text"
                  id="primerNombre"
                  name="primerNombre"
                  class="form-control"
                  required
                >
              </div>

              <div class="col-md-6 mb-3">
                <label for="segundoNombre" class="form-label">Segundo nombre (opcional)</label>
                <input
                  type="text"
                  id="segundoNombre"
                  name="segundoNombre"
                  class="form-control"
                >
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="primerApellido" class="form-label">Primer apellido</label>
                <input
                  type="text"
                  id="primerApellido"
                  name="primerApellido"
                  class="form-control"
                  required
                >
              </div>

              <div class="col-md-6 mb-3">
                <label for="segundoApellido" class="form-label">Segundo apellido</label>
                <input
                  type="text"
                  id="segundoApellido"
                  name="segundoApellido"
                  class="form-control"
                  required
                >
              </div>
            </div>

            <div class="mb-3">
              <label for="fechaNacimiento" class="form-label">Fecha de nacimiento</label>
              <input
                type="date"
                id="fechaNacimiento"
                name="fechaNacimiento"
                class="form-control"
                required
              >
            </div>

            <button type="button" class="btn btn-secondary" onclick="siguientePaso(1)">
              Atrás
            </button>
            <button type="button" class="btn btn-primary" onclick="siguientePaso(3)">
              Continuar
            </button>
          </section>

          <!-- Paso 3 -->
          <section id="paso-3" class="paso-seccion" hidden>
            <h2 class="h4 mb-3">3. Correo electrónico</h2>

            <div class="mb-3">
              <label for="correo" class="form-label">Correo electrónico</label>
              <input
                type="email"
                id="correo"
                name="correo"
                class="form-control"
                placeholder="nombre@ejemplo.com"
                required
              >
            </div>

            <div class="mb-3">
              <label for="confirmarCorreo" class="form-label">Confirmar correo electrónico</label>
              <input
                type="email"
                id="confirmarCorreo"
                name="confirmarCorreo"
                class="form-control"
                required
              >
            </div>

            <button type="button" class="btn btn-secondary" onclick="siguientePaso(2)">
              Atrás
            </button>
            <button type="submit" class="btn btn-success">
              Finalizar registro
            </button>
          </section>
        </form>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script>
    const formulario = document.getElementById('formRegistro');
    const pasos = formulario.querySelectorAll('.paso-seccion');
    const correo = document.getElementById('correo');
    const confirmarCorreo = document.getElementById('confirmarCorreo');
    let pasoActual = 1;

    function mostrarPaso(numero) {
      for (const paso of pasos) {
        paso.hidden = paso.id !== `paso-${numero}`;
      }
      pasoActual = numero;
    }

    function validarPaso(numero) {
      const seccion = document.getElementById(`paso-${numero}`);
      const campos = seccion.querySelectorAll('input, select');

      for (const campo of campos) {
        if (campo.type === 'text') {
          campo.value = campo.value.trim();
        }

        if (!campo.checkValidity()) {
          mostrarPaso(numero);
          campo.reportValidity();
          return false;
        }
      }

      return true;
    }

    function siguientePaso(destino) {
      if (destino > pasoActual && !validarPaso(pasoActual)) {
        return;
      }

      mostrarPaso(destino);
      document.querySelector(`#paso-${destino} input, #paso-${destino} select`).focus();
    }

    // El script muestra el paso correspondiente antes de señalar un campo inválido.
    formulario.noValidate = true;

    formulario.addEventListener('submit', function (evento) {
      // Pulsar Enter en los primeros pasos equivale a pulsar Continuar.
      if (pasoActual < pasos.length) {
        evento.preventDefault();
        siguientePaso(pasoActual + 1);
        return;
      }

      const coinciden = correo.value.trim() === confirmarCorreo.value.trim();
      confirmarCorreo.setCustomValidity(coinciden ? '' : 'Los correos deben coincidir.');

      for (let numero = 1; numero <= pasos.length; numero++) {
        if (!validarPaso(numero)) {
          evento.preventDefault();
          return;
        }
      }
    });
  </script>
</body>
</html>